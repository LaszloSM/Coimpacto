# Copiar a .env para desarrollo local. Nunca subir .env al repositorio.
DJANGO_DEBUG=1
# Obligatoria fuera de desarrollo. Generar con:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://credimpacto:credimpacto@localhost:5432/credimpacto
