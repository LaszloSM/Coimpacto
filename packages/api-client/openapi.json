{
  "openapi": "3.1.0",
  "info": {
    "title": "Credimpacto API",
    "version": "0.1.0",
    "description": "Libro contable de las ACAP. Credimpacto no custodia ni capta dinero."
  },
  "paths": {
    "/api/salud": {
      "get": {
        "operationId": "core_api_salud",
        "summary": "Estado del servicio",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Salud"
                }
              }
            }
          }
        },
        "description": "Responde si el servicio y la base de datos están arriba. No expone datos.",
        "tags": [
          "core"
        ]
      }
    },
    "/api/enrolamiento/codigos": {
      "post": {
        "operationId": "cuentas_api_emitir_codigo",
        "summary": "Emitir un código QR de un solo uso para registrar un celular",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CodigoEmitido"
                }
              }
            }
          }
        },
        "description": "Solo para facilitadores con permiso. El código vence a los 15 minutos.",
        "tags": [
          "enrolamiento"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PedidoCodigo"
              }
            }
          },
          "required": true
        },
        "security": [
          {
            "SessionAuth": []
          }
        ]
      }
    },
    "/api/enrolamiento/canjear": {
      "post": {
        "operationId": "cuentas_api_canjear_codigo",
        "summary": "Registrar este celular con el código del facilitador",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DispositivoRegistrado"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Rechazo"
                }
              }
            }
          }
        },
        "description": "El celular envía el código leído y su llave pública de dispositivo.",
        "tags": [
          "enrolamiento"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PedidoCanje"
              }
            }
          },
          "required": true
        }
      }
    },
    "/api/sync/lotes": {
      "post": {
        "operationId": "sync_api_subir_lote",
        "summary": "Subir un lote de la cola del celular (formato 1)",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultadoLote"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Rechazo"
                }
              }
            }
          }
        },
        "description": "Cada elemento vuelve con su estado: confirmado, por_validar, rechazado, en_conflicto o\nen_espera (el celular lo reenvía después). Ver sync/servicio.py.",
        "tags": [
          "sincronizacion"
        ]
      }
    },
    "/api/sync/reto": {
      "post": {
        "operationId": "sync_api_pedir_reto",
        "summary": "Pedir un número de un solo uso para bajar los datos del grupo",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Reto"
                }
              }
            }
          }
        },
        "tags": [
          "sincronizacion"
        ]
      }
    },
    "/api/sync/grupo": {
      "post": {
        "operationId": "sync_api_bajar_grupo",
        "summary": "Bajar los datos del grupo para llevar la reunión sin señal",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response",
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Rechazo"
                }
              }
            }
          },
          "410": {
            "description": "Gone",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Rechazo"
                }
              }
            }
          }
        },
        "description": "El celular firma {\"pedido\": \"grupo\", \"reto\": …}. Un celular retirado recibe 410 y borra\nsus datos locales después de subir su cola (E3).",
        "tags": [
          "sincronizacion"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PedidoGrupo"
              }
            }
          },
          "required": true
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Salud": {
        "properties": {
          "estado": {
            "title": "Estado",
            "type": "string"
          },
          "base_de_datos": {
            "title": "Base De Datos",
            "type": "string"
          }
        },
        "required": [
          "estado",
          "base_de_datos"
        ],
        "title": "Salud",
        "type": "object"
      },
      "CodigoEmitido": {
        "properties": {
          "codigo": {
            "title": "Codigo",
            "type": "string"
          },
          "qr": {
            "title": "Qr",
            "type": "string"
          },
          "vence_en": {
            "format": "date-time",
            "title": "Vence En",
            "type": "string"
          }
        },
        "required": [
          "codigo",
          "qr",
          "vence_en"
        ],
        "title": "CodigoEmitido",
        "type": "object"
      },
      "PedidoCodigo": {
        "properties": {
          "acap_id": {
            "format": "uuid",
            "title": "Acap Id",
            "type": "string"
          }
        },
        "required": [
          "acap_id"
        ],
        "title": "PedidoCodigo",
        "type": "object"
      },
      "DispositivoRegistrado": {
        "properties": {
          "dispositivo_id": {
            "format": "uuid",
            "title": "Dispositivo Id",
            "type": "string"
          },
          "acap_id": {
            "format": "uuid",
            "title": "Acap Id",
            "type": "string"
          },
          "acap_nombre": {
            "title": "Acap Nombre",
            "type": "string"
          }
        },
        "required": [
          "dispositivo_id",
          "acap_id",
          "acap_nombre"
        ],
        "title": "DispositivoRegistrado",
        "type": "object"
      },
      "Rechazo": {
        "properties": {
          "codigo": {
            "title": "Codigo",
            "type": "string"
          }
        },
        "required": [
          "codigo"
        ],
        "title": "Rechazo",
        "type": "object"
      },
      "PedidoCanje": {
        "properties": {
          "codigo": {
            "title": "Codigo",
            "type": "string"
          },
          "llave_publica": {
            "title": "Llave Publica",
            "type": "string"
          }
        },
        "required": [
          "codigo",
          "llave_publica"
        ],
        "title": "PedidoCanje",
        "type": "object"
      },
      "ResultadoElemento": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "estado": {
            "title": "Estado",
            "type": "string"
          },
          "codigo": {
            "title": "Codigo",
            "type": "string"
          }
        },
        "required": [
          "id",
          "estado",
          "codigo"
        ],
        "title": "ResultadoElemento",
        "type": "object"
      },
      "ResultadoLote": {
        "properties": {
          "resultados": {
            "items": {
              "$ref": "#/components/schemas/ResultadoElemento"
            },
            "title": "Resultados",
            "type": "array"
          }
        },
        "required": [
          "resultados"
        ],
        "title": "ResultadoLote",
        "type": "object"
      },
      "Reto": {
        "properties": {
          "reto": {
            "title": "Reto",
            "type": "string"
          }
        },
        "required": [
          "reto"
        ],
        "title": "Reto",
        "type": "object"
      },
      "PedidoGrupo": {
        "properties": {
          "reto": {
            "title": "Reto",
            "type": "string"
          },
          "firma": {
            "title": "Firma",
            "type": "string"
          }
        },
        "required": [
          "reto",
          "firma"
        ],
        "title": "PedidoGrupo",
        "type": "object"
      }
    },
    "securitySchemes": {
      "SessionAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sessionid"
      }
    }
  },
  "servers": []
}