{
  "openapi": "3.1.0",
  "info": {
    "title": "Credimpacto API",
    "version": "0.1.0",
    "description": "Libro contable de las ACAP. Credimpacto no custodia ni capta dinero."
  },
  "paths": {
    "/api/salud": {
      "get": {
        "operationId": "core_api_salud",
        "summary": "Estado del servicio",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Salud"
                }
              }
            }
          }
        },
        "description": "Responde si el servicio y la base de datos están arriba. No expone datos.",
        "tags": [
          "core"
        ]
      }
    },
    "/api/enrolamiento/codigos": {
      "post": {
        "operationId": "cuentas_api_emitir_codigo",
        "summary": "Emitir un código QR de un solo uso para registrar un celular",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CodigoEmitido"
                }
              }
            }
          }
        },
        "description": "Solo para facilitadores con permiso. El código vence a los 15 minutos.",
        "tags": [
          "enrolamiento"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PedidoCodigo"
              }
            }
          },
          "required": true
        },
        "security": [
          {
            "SessionAuth": []
          }
        ]
      }
    },
    "/api/enrolamiento/canjear": {
      "post": {
        "operationId": "cuentas_api_canjear_codigo",
        "summary": "Registrar este celular con el código del facilitador",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DispositivoRegistrado"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Rechazo"
                }
              }
            }
          }
        },
        "description": "El celular envía el código leído y su llave pública de dispositivo.",
        "tags": [
          "enrolamiento"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PedidoCanje"
              }
            }
          },
          "required": true
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Salud": {
        "properties": {
          "estado": {
            "title": "Estado",
            "type": "string"
          },
          "base_de_datos": {
            "title": "Base De Datos",
            "type": "string"
          }
        },
        "required": [
          "estado",
          "base_de_datos"
        ],
        "title": "Salud",
        "type": "object"
      },
      "CodigoEmitido": {
        "properties": {
          "codigo": {
            "title": "Codigo",
            "type": "string"
          },
          "qr": {
            "title": "Qr",
            "type": "string"
          },
          "vence_en": {
            "format": "date-time",
            "title": "Vence En",
            "type": "string"
          }
        },
        "required": [
          "codigo",
          "qr",
          "vence_en"
        ],
        "title": "CodigoEmitido",
        "type": "object"
      },
      "PedidoCodigo": {
        "properties": {
          "acap_id": {
            "format": "uuid",
            "title": "Acap Id",
            "type": "string"
          }
        },
        "required": [
          "acap_id"
        ],
        "title": "PedidoCodigo",
        "type": "object"
      },
      "DispositivoRegistrado": {
        "properties": {
          "dispositivo_id": {
            "format": "uuid",
            "title": "Dispositivo Id",
            "type": "string"
          },
          "acap_id": {
            "format": "uuid",
            "title": "Acap Id",
            "type": "string"
          },
          "acap_nombre": {
            "title": "Acap Nombre",
            "type": "string"
          }
        },
        "required": [
          "dispositivo_id",
          "acap_id",
          "acap_nombre"
        ],
        "title": "DispositivoRegistrado",
        "type": "object"
      },
      "Rechazo": {
        "properties": {
          "motivo": {
            "title": "Motivo",
            "type": "string"
          },
          "mensaje": {
            "title": "Mensaje",
            "type": "string"
          }
        },
        "required": [
          "motivo",
          "mensaje"
        ],
        "title": "Rechazo",
        "type": "object"
      },
      "PedidoCanje": {
        "properties": {
          "codigo": {
            "title": "Codigo",
            "type": "string"
          },
          "llave_publica": {
            "title": "Llave Publica",
            "type": "string"
          }
        },
        "required": [
          "codigo",
          "llave_publica"
        ],
        "title": "PedidoCanje",
        "type": "object"
      }
    },
    "securitySchemes": {
      "SessionAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sessionid"
      }
    }
  },
  "servers": []
}