# Copiar a deploy/.env en el servidor (nunca al repositorio) y llenar. instalar.sh genera las
# claves aleatorias; lo que dice "pegar" lo da cada paso de docs/operacion/servidor-aws.md.

# Nombre del servidor: con IP fija 3.85.12.7 → 3-85-12-7.sslip.io (o el dominio cuando exista).
CREDIMPACTO_HOST=

POSTGRES_PASSWORD=
CREDIMPACTO_PG_MIGRACIONES=
CREDIMPACTO_PG_WEB=
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0

# Llave privada del respaldo en una sola línea, con \n (generar_llave_respaldo). Pegar.
CREDIMPACTO_RESPALDO_LLAVE=

# Token con que CI publica actualizaciones de JavaScript (TX9). Opcional en el piloto.
CREDIMPACTO_ACTUALIZACIONES_TOKEN=
